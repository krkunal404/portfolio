PORT=5000
NODE_ENV=production

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=http://localhost:5173

# Set to 1 when running behind a reverse proxy / PaaS (Render, Railway, Nginx)
# so rate limiting sees the real client IP.
TRUST_PROXY=

# Email Option 1: Resend (Recommended, free 3,000 emails/mo)
# 1. Sign up at https://resend.com
# 2. Create API key under API Keys
RESEND_API_KEY=re_123456789
EMAIL_TO=krkunnal404@gmail.com
# RESEND_FROM=Portfolio Contact <onboarding@resend.dev>

# Email Option 2: Gmail (Requires App Password)
# EMAIL_SERVICE=gmail
# EMAIL_USER=you@example.com
# EMAIL_PASS=your-app-password

